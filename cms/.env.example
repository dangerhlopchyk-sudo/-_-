# Рядок підключення до Neon PostgreSQL (Dashboard → Connection string → Pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Будь-який довгий випадковий рядок (наприклад, результат: openssl rand -hex 32)
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Адреса задеплоєного фронтенду (для CORS). Локально — Vite на 5173
FRONTEND_URL=http://localhost:5173
